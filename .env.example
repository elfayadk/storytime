# ─────────────────────────────────────────────────────────────────────────────
# Storytime v2 - configuration. EVERYTHING here is OPTIONAL.
# The app runs fully on free, public endpoints with no keys at all.
# Tokens/creds below only raise rate limits or unlock a blocked source.
# ─────────────────────────────────────────────────────────────────────────────

# General
STORYTIME_TZ=UTC
STORYTIME_LIMIT=50
PORT=3000
# SQLite file (embedded DB, no server needed)
STORYTIME_DB=./data/storytime.db

# GitHub - OPTIONAL token raises the public rate limit 60/hr → 5000/hr.
# Create at https://github.com/settings/tokens (no scopes needed for public data).
GITHUB_TOKEN=

# Reddit - the public .json endpoint is blocked from many cloud IPs.
# OPTIONAL free app for reliable access: https://www.reddit.com/prefs/apps
# (choose "script", any redirect URL). No cost.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=storytime/2.0 (by /u/yourname)

# Mastodon - default instance used when a bare username has no @instance.
MASTODON_INSTANCE=mastodon.social

# Bluesky - public AppView needs no auth. Override only if self-hosting.
BLUESKY_SERVICE=https://public.api.bsky.app

# RSS feeds and Pastebin IDs (comma or newline separated), optional defaults.
RSS_FEEDS=
PASTEBIN_IDS=

# Geocoding via OpenStreetMap Nominatim (free). Set an email per their policy.
GEOCODE_ENABLED=true
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org/search
NOMINATIM_EMAIL=

# Optional local LLM via Ollama (free, runs on your machine).
# Powers AI summaries, the timeline narrative, and "ask your timeline" (RAG).
# Install: https://ollama.com  →  `ollama pull llama3.2`
OLLAMA_ENABLED=false
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Semantic layer (embeddings for search / themes / RAG) ────────────────────
# The embedder auto-selects the best AVAILABLE engine and always works:
#   1) Ollama (if OLLAMA_ENABLED) using the model below
#   2) Transformers.js in-process - enable with `npm i @huggingface/transformers`
#   3) a dependency-free hashed fallback (zero setup)
OLLAMA_EMBED_MODEL=nomic-embed-text
TRANSFORMERS_EMBED_MODEL=Xenova/all-MiniLM-L6-v2
