{
  "name": "@storytime/core",
  "version": "2.0.0",
  "description": "Storytime core: free/OSS ingestion, NLP enrichment, and export engine",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "storytime": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/cli.ts",
    "cli": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --test --import tsx ./test/*.test.ts",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "compromise": "^14.14.4",
    "luxon": "^3.5.0",
    "natural": "^8.0.1",
    "ora": "^8.1.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
